FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY prompts ./prompts
COPY data/instructional ./data/instructional
COPY data/processed ./data/processed
COPY data/artifacts ./data/artifacts
RUN pip install --upgrade pip && pip install ".[web,dense,providers]"

EXPOSE 8000
CMD ["uvicorn", "ai_tutor.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
